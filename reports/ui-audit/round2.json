{
  "scope": "Second node web UI repair batch; no firmware packaging",
  "device": "GT-BE19000AI at 192.168.100.15",
  "findings": [
    {
      "id": "switch-usb-blank",
      "cause": "Both pages take a special re_mode=1 path that skips show_menu(), and therefore skip the wrapper setup that reveals the body. The iframe document is present but visibility:hidden.",
      "fix": "Use the normal wrapper initialization when isWebWrapper is true; keep the original direct per-node page path otherwise.",
      "verified": "Chrome displays Switch Control with Jumbo/STP/LACP and USB application list with Servers Center, printer server and Download Master. No settings submitted."
    },
    {
      "id": "operation-modes",
      "cause": "Current firmware exposes router/AP/AiMesh options and disables repeater and media-bridge controls through capability flags. Legacy wlc_psta=2 classification incorrectly displays Repeater explanation for an actual re_mode=1 node.",
      "fix": "Actual AiMesh membership takes display precedence; select the AiMesh radio and explain current firmware options.",
      "verified": "Three supported choices remain; AiMesh value 5 is checked, the other choices remain unchanged. No network mode changed.",
      "limit": "This does not prove hardware cannot support standalone repeater/media bridge; those modes have not been enabled or tested."
    },
    {
      "id": "wireless-header",
      "cause": "wl_status_array() selects wl0/wl1/wl2 for proxy/repeater modes, while the real main front-haul AP is on wl*.2. It emits Not associated, channel 0 and empty BSSID. The same response's detailed wl log has correct AP status.",
      "fix": "Safely parse existing response data, derive main AP header from the detailed log by frequency band, reset each snapshot, and use actual per-band authorized station records.",
      "verified": "Driver wl*.2 status matches rendered BSSID and channels. Live Chrome shows channels 6, 100/160 and 6g5/320-1 and populated client tables.",
      "additional": [
        "Label SSID groups without calling every subunit a Guest Network.",
        "Handle empty-IP cache fallback.",
        "Escape long names and SSIDs when inserted into table markup.",
        "Show per-band authorized links with an MLO caveat rather than claim unique physical-device counts."
      ]
    },
    {
      "id": "wifi-insight",
      "cause": "Stock httpd has no get_diag_raw_data.cgi route. Existing latest channel_change and wifi_detect queries returned empty contents; airiq_enable is 0.",
      "fix": "For this node show a live AP-status table with primary channel, bandwidth, BSSID, QBSS utilization, noise and authorized links, using the same snapshot as the dashboard client card.",
      "verified": {
        "primary_channels": [
          6,
          100,
          5
        ],
        "bandwidth_MHz": [
          20,
          160,
          320
        ],
        "sample_counts": [
          1,
          3,
          1
        ],
        "refresh_seconds": 5
      },
      "limit": "Historical events, spectrum data and non-Wi-Fi interference analysis are not implemented by this change. AIRIQ has not been enabled. This is a live-status alternative to the unusable node chart."
    }
  ],
