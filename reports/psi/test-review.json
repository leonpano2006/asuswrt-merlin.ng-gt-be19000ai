  "findings": [
    {
      "id": "notification_error_false_positive",
      "severity": "medium",
      "status": "fixed_and_strict_qemu_passed",
      "detail": "Original notified_poll/notified_epoll accepted PRI together with ERR. An absent trigger intentionally returns PRI|ERR, so that path could have satisfied a pressure-event assertion. Old logs contain no revents values and cannot exclude that false positive.",
      "correction": "All pressure notification waits now reject ERR as well as HUP; poll also rejects NVAL. Only ordinary cgroup.events opts into allow_error=1 because its kernfs event ABI legitimately returns PRI|ERR.",
      "old_evidence_policy": "Preserved unchanged; do not use the old functional run alone to claim pressure event delivery was strictly validated.",
      "validation": "psi7-functional-strict completed with all pressure PRI notification checks rejecting ERR/HUP. Its archive SHA matches the corrected source manifest; psi7-disabled-strict also passed. Old evidence remains preserved."
    },
    {
      "id": "cpu_cgroup_migration",
      "severity": "info",
      "status": "pass_with_scope_limit",
      "detail": "Both CPU workers remain pinned to one vCPU. Their cgroup.procs moves are checked for write success; source/parent totals increase, destination total increases after migration, and source total stops increasing after workers leave. This proves live cgroup migration accounting, not forced CPU-to-CPU migration of a stalled task.",
      "observed_microseconds": {
        "child_delta": 755797,
        "parent_delta": 759434,
        "destination_delta": 754181
      },
      "not_covered": "A controlled cross-CPU iowait/memstall wake migration is not asserted by this fixture."
