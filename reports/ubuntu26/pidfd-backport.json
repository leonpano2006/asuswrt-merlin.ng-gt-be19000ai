  "abi_design": [
    "No task_struct, signal_struct, struct pid or other vendor-layout fields added/removed/reordered",
    "256 static hashed poll wait queues preserve struct pid numbers[] offset and size; readiness still checks referenced pid under RCU",
    "Exported fork/do_fork signatures unchanged; private copy_process adds pidfd return pointer",
    "Kernel thread and idle callers never request CLONE_PIDFD",
    "pidfd files retain struct pid; numeric PID reuse cannot retarget handles",
    "Upstream process-signal permissions and pid namespace boundary validation retained; AArch32 siginfo explicitly converted"
  ],
  "fdinfo_extension": "Pid=-1 when task has been reaped; NSpid namespace hierarchy",
  "cleanup_review": [
    "get_unused_fd_flags happens after copy_files to avoid leaking fd into private child descriptor table",
    "fd_install occurs after last failure point",
    "EFAULT after parent fd copy attempt drops file reference and reserved fd before freeing pid",
    "cgroup_can_fork failure passes threadgroup unlock and file cleanup",
    "early allocation failures bypass cgroup unlock because begin has not run"
  ],
