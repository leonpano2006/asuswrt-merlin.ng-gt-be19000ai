+        ((manager_identity_rejected+=1))
+        continue
+    elif [[ "$ID_PPID" != 1 ]]; then
+        ((manager_role_rejected+=1))
+        continue
+    fi
     capture /usr/bin/cat "/proc/$manager/task/$manager/children"
