             manager_pids+=("$pid")
-        fi
+            ((managers_found+=1))
+        fi
+    else
+        ((initial_nonmatching_exe+=1))
     fi
 done
 for manager in "${manager_pids[@]}"; do
     [[ "$candidate_count" -lt 4 ]] || break
-    identity "$manager" "$UDEV_EXE" && [[ "$ID_PPID" == 1 ]] || continue
