      "after": "#include \"trial-policy.h\"\n#include \"accepted-runtime.h\"\n",
      "after_sha256": "137f39d99b410ffca16a6a45196644010c415e213b3b1f0335c04e8c3ac4cde9",
      "before": "#include \"trial-policy.h\"\n",
      "before_sha256": "9c79e74e4118e137af13a025cc8d87b4fcdb4a9f10d1b4b7d6588f76cb649970",
      "label": "accepted-runtime-include"
    },
    {
      "after": "/* Acceptance never performs a block read in the watchdog owner. Only a\n * completed, reaped result=1 from the unchanged bounded metadata child can\n * authorize it. An active child is a retryable refusal, never success. */\n#define ACCEPT_METADATA_FRESH_MS UINT64_C(6500)\nstruct accept_context {struct accepted_runtime *normal;struct trial_policy *trial;struct trial_worker *worker,*metadata_worker;bool *failed,*handed,*have_metadata_success;uint64_t *last_metadata_success;};\nstatic int accepted_metadata_ready(const struct accept_context *c,uint64_t now){\n if(*c->failed||!*c->handed||c->normal->failed||c->worker->failed||c->metadata_worker->failed)return EPERM;\n if(c->worker->pid||c->metadata_worker->pid)return EAGAIN;\n if(!*c->have_metadata_success||now<*c->last_metadata_success||now-*c->last_metadata_success>ACCEPT_METADATA_FRESH_MS)return EPERM;\n return 0;\n}\nstatic int accept_current_boot(void *opaque,uint64_t requested_at,uint64_t sequence){\n struct accept_context *c=opaque;uint64_t now=clock_ms();\n if(now<requested_at)return EPERM;\n int ready=accepted_metadata_ready(c,now);if(ready)return ready;\n if(!trial_tick(c->trial,now,true)){trial_diagnostics_failure(\"accept-trial-policy\",c->trial->reason);*c->failed=true;return EPERM;}\n return accepted_runtime_activate(c->normal,now,sequence,c->trial->phase==TRIAL_HEALTHY,true);\n}\nint trial_production_main(void){",
      "after_sha256": "f5becd9914a38d1c2cb8e416d5e278de77f29eb4f0b9dbf69010d7997e467b54",
      "before": "int trial_production_main(void){",
      "before_sha256": "b7321118cbfd2ab13530b082dcef9f099073a14ddb3d7af0e823a04c7c48daee",
      "label": "cached-metadata-acceptance-callback"
    },
    {
      "after": "struct trial_policy policy={0};bool handed=false,failed=false,have_metadata_success=false;uint64_t armed=clock_ms(),last_ping=armed,last_success=armed,last_metadata=armed,last_metadata_success=0,last_collect=0,local_sequence=0;struct trial_worker worker={0},metadata_worker={0};\n struct accepted_runtime normal;accepted_runtime_init(&normal,watchdog);\n struct accept_context accept={&normal,&policy,&worker,&metadata_worker,&failed,&handed,&have_metadata_success,&last_metadata_success};control.accept_boot=accept_current_boot;control.accept_context=&accept;",
      "after_sha256": "a085c3e41e03278f317e1c60a61557432ad1ec08430270f5616c57daa9c5410a",
      "before": "struct trial_policy policy={0};bool handed=false,failed=false;uint64_t armed=clock_ms(),last_ping=armed,last_success=armed,last_metadata=armed,last_collect=0,local_sequence=0;struct trial_worker worker={0},metadata_worker={0};",
      "before_sha256": "6affb5e6623b0cbae18720a40285f4db1598f58745bb4007215e684d8ee72299",
      "label": "same-owner-runtime-and-cache-state"
    },
    {
      "after": "   trial_diagnostics_failure(\"metadata-recheck\",EIO);failed=true;\n  }else if(metadata_collected==1){have_metadata_success=true;last_metadata_success=now;}\n  if(!failed&&!metadata_worker.pid",
      "after_sha256": "f9c79c4e4e3dd07f2781ede2efee96b9faf089aa6a155309ec8ae323f4e59ea3",
      "before": "   trial_diagnostics_failure(\"metadata-recheck\",EIO);failed=true;\n  }\n  if(!failed&&!metadata_worker.pid",
      "before_sha256": "9c1b9ea48b4a107bb50807dbce34fbe850730873399f7dfa5f1459679a1e293c",
      "label": "cache-only-completed-successful-metadata-result"
    },
    {
      "after": "  else if(collected==1&&!failed){\n   if(collected_bits&~(TRIAL_ALL_LOCAL|(ACCEPT_CORE_ALL<<ACCEPT_CORE_SHIFT))){trial_diagnostics_failure(\"worker-result-invalid\",collected_bits);failed=true;}\n   else {accepted_runtime_core(&normal,now,collected_bits>>ACCEPT_CORE_SHIFT);\n    if(normal.failed){trial_diagnostics_failure(\"accepted-core-result\",EPERM);failed=true;}\n    else if(!normal.accepted)(void)trial_local_result(&policy,now,nonce,++local_sequence,collected_bits&TRIAL_ALL_LOCAL);}\n  }",
      "after_sha256": "8d450314d3b4902b9ee7444fb2d30f171465d3c49c9ff9c8371ab06e5daff666",
      "before": "  else if(collected==1&&!failed){if(collected_bits&~TRIAL_ALL_LOCAL){trial_diagnostics_failure(\"worker-result-invalid\",collected_bits);failed=true;}else (void)trial_local_result(&policy,now,nonce,++local_sequence,collected_bits);}",
      "before_sha256": "68fc48d111de81aec267b9b73248861d2b62f79740fa546b8f6ebbd78a725a0e",
      "label": "bounded-health-child-observes-core-seven"
    },
    {
      "after": "trial_worker_start(&worker,now,boot,normal.accepted?accepted_collect_core:accepted_collect_trial)",
      "after_sha256": "fdf74f06eaf2d4ae55ec39e7f167239f0b1d44bbd7cae2f54c3c8be9b6f54a48",
      "before": "trial_worker_start(&worker,now,boot,trial_collect_health)",
      "before_sha256": "558d0f432a360c4758230a49f333dcc77b0162fc54464de0ad0ffa59e7d37d08",
