  "findings": [
    {
      "id": "systemd-custom-fallback-can-be-replaced",
      "severity": "high",
      "status": "open",
      "packages": [
        "systemd",
        "systemd-sysv",
        "udev",
        "libsystemd-shared",
        "libsystemd0",
        "libudev1"
      ],
      "installed": "259.5-0ubuntu3.4+leonb53.2",
      "current_snapshot_official": "259.5-0ubuntu3.4",
      "risk": "The current official revision is lower, but a later official revision such as the explicitly hypothetical 259.5-0ubuntu3.5 sorts above +leonb53.2. With no hold/pin it can become the selected candidate and replace the coherent family. Official signatures authenticate origin; they do not retain this project's legacy credentials mount fallback.",
      "impact": "Previously verified service credentials on Linux 4.19 can fail again if an unpatched systemd/libsystemd-shared is selected. Exact-version dependencies keep related packages consistent but do not protect project modifications.",
      "required_gate": "Publish tested rebases of the complete required systemd family through an authenticated custom source and exercise upgrade/rollback with real credential services on the exact kernel."
    },
    {
      "id": "newer-gnu-builds-need-own-security-maintenance",
      "severity": "high",
      "status": "open",
      "packages": [
        "libc6",
        "libc6-dev",
        "libc-bin",
        "libc-dev-bin",
        "libc-gconv-modules-extra",
        "gcc-16-base",
        "libgcc-s1",
        "libstdc++6",
        "binutils"
      ],
      "snapshot_examples": {
        "glibc": "2.43-2ubuntu2.4",
        "gcc_runtime": "16-20260322-1ubuntu1",
        "binutils": "2.46-3ubuntu2"
      },
      "risk": "Installed 2.44 / 16.2.0 / 2.47 versions are above the recorded Resolute packages. Security fixes released only on lower Resolute branches will not automatically be applied to these custom newer branches. If a future official version does overtake them, no current policy preserves the tested custom build.",
      "qualification": "This audit does not assert an unpatched vulnerability is currently present, nor that official GNU packages are necessarily incompatible. GNU changes include the explicit 4.19 build baseline and CPU tuning; the known required old-mount fallback is in systemd.",
      "required_gate": "Track security fixes applicable to the chosen newer GNU branches, rebase/rebuild with preserved package semantics, validate on kernel10, and publish authenticated project revisions. A permanent hold alone is not a security maintenance solution."
    },
    {
      "id": "multiarch-coinstall-version-gap",
      "severity": "high",
      "status": "open",
      "rule": "For each Multi-Arch:same package name, simultaneously installed arm64/armel/armhf instances must carry the same full Debian version; matching upstream 2.44 or GCC16 alone is insufficient. Different ABI package payloads are still separately built and ABI-correct.",
      "glibc": "libc6, libc-gconv-modules-extra and libc6-dev are Multi-Arch:same. libc6 requires the exact gconv version; libc6-dev requires exact libc6 and libc-dev-bin. libc-bin/libc-dev-bin are Multi-Arch:foreign, so do not assume three copies are needed.",
      "gcc": "gcc-16-base, libgcc-s1, libstdc++6 and other runtime/development libraries are Multi-Arch:same; runtimes require the exact gcc-16-base version. Native triplet compiler executables marked Multi-Arch:foreign are not a substitute for foreign-ABI runtime packages.",
      "systemd": "libsystemd0/libudev1/libsystemd-shared are also Multi-Arch:same; future foreign packages that need them require coherent custom builds too.",
      "current_gap": "Only custom arm64 is installed. Official armhf libc6/GCC runtime versions differ from the custom arm64 versions; a plain apt install libc6:armhf or a dependent foreign application cannot be assumed to coinstall. armel is registered with dpkg but excluded from official sources because Ubuntu does not publish that ABI.",
      "development_headers": "A real libc6-dev:armel also needs an ABI-correct linux-libc-dev:armel dependency. Cross-SDK sysroot packages are not a native armel repository replacement.",
      "required_gate": "Build and publish matching complete ABI families and required dependency closure, then test actual arm64+armel+armhf installation and coordinated upgrades. Keep the native-only acceptance claim until then."
    },
    {
      "id": "local-artifacts-are-not-an-update-channel",
      "severity": "medium",
      "status": "open",
      "risk": "The 41 packages were installed from local .deb paths during bootstrap and those temporary .debs were removed. Their hashes and source provenance are recorded, but no custom Packages/Release/InRelease/Signed-By channel is configured for later installs or fixes. The rootfs tar itself is not signed.",
      "required_gate": "Set up a deliberately owned signing identity, scoped Signed-By configuration and auditable release metadata only when authorized for implementation; do not invent a key or use trusted=yes/allow-unauthenticated."
    }
  ],
  "proposed_release_policy_not_applied": [
    "Keep signed Resolute sources enabled for ordinary supported dependency updates; do not globally freeze or mix an entire development distribution into the rootfs.",
    "Serve the custom GNU/systemd ABI families from a dedicated signed repository with an explicit maintained release scope. Add package-scoped preference rules that select approved project builds and prevent accidental replacement by an unvalidated official build; key trust and package preferences solve different problems.",
    "An exact hold or allowlist can be a temporary controlled deployment measure, but must expose pending security updates and cannot substitute for the custom rebuild/retest pipeline.",
    "Before each project update: verify source signatures/hashes, rebuild relevant complete ABI families, check control data and dependency closure, simulate upgrades, and boot/run compatibility tests on the exact kernel before publishing.",
    "Test update rollback and keep recoverable prior package/rootfs artifacts. Do not claim repository-based reproducible rollback from live upstream indices alone."
  ],
