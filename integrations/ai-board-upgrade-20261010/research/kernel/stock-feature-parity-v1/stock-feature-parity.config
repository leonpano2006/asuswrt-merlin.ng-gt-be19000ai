# Proposed only: restore capabilities present in the captured ASUS5.15 module cohort.
# No current candidate/build configuration has been changed.
# Modular autofs preserves functionality and the compact Image size budget.
CONFIG_AUTOFS_FS=m

# Stock shipped both openvswitch.ko and vport-vxlan.ko.
CONFIG_OPENVSWITCH=m
CONFIG_VXLAN=m
CONFIG_OPENVSWITCH_VXLAN=m

# Exact stock TPS6286x family, NOT a replacement by TPS6287x.
# ASUS DT uses SY8827N, so this passive I2C driver has no matching board node.
# Retain as a module only for shipped-driver/autoload parity; no DT/voltage changes.
CONFIG_REGULATOR_TPS6286X=m

# Actual ASUS stock bcmdhd.ko exposes SDIO aliases/probe, not PCIe.
# Keep firmware/NVRAM/OOB settings and all DT nodes unchanged.
CONFIG_BCMDHD=m
CONFIG_BCMDHD_SDIO=y
# CONFIG_BCMDHD_PCIE is not set
# CONFIG_BCMDHD_PCIE_RUNTIMEPM is not set
