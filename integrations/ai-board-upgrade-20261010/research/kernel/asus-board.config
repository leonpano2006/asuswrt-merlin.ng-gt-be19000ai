# Required by the ASUS GT-BE19000AI board DT; absent from reference RDK defconfig.
CONFIG_REGULATOR_SY8827N=y
# Preserve the ASUS thermal-zone / hwmon provider and CPU cooling support.
CONFIG_HWMON=y
CONFIG_SENSORS_DOLPHIN=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
# The user's explicit requirement overrides dolphin_defconfig's builtin zram.
CONFIG_ZRAM=m
