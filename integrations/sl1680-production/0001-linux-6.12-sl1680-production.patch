+			sl1680_l2_placement.pending = true;
+		}
+#endif
 		pmd_phys = pgtable_alloc(PMD_SHIFT);
+#ifdef CONFIG_ARM64_SL1680_L2_PLACEMENT
+		if (sl1680_l2_placement.pending)
+			sl1680_l2_placement.pending = false;
+#endif
 		pmdp = pmd_set_fixmap(pmd_phys);
 		init_clear_pgtable(pmdp);
 		pmdp += pmd_index(addr);
@@ -648,6 +752,8 @@ static void __init map_mem(pgd_t *pgdp)
 	if (can_set_direct_map())
 		flags |= NO_BLOCK_MAPPINGS | NO_CONT_MAPPINGS;
 
+	sl1680_l2_begin(pgdp);
+
 	/*
 	 * Take care not to create a writable alias for the
 	 * read-only text and rodata sections of the kernel image.
@@ -683,6 +789,7 @@ static void __init map_mem(pgd_t *pgdp)
 		       PAGE_KERNEL, NO_CONT_MAPPINGS);
 	memblock_clear_nomap(kernel_start, kernel_end - kernel_start);
 	arm64_kfence_map_pool(early_kfence_pool, pgdp);
+	sl1680_l2_finish();
 }
 
