+/* Register-only SEA evidence; no table walk, probe, or recovery change. */
+static void leon_sea_register_snapshot(unsigned long far, unsigned long esr,
+				       const struct pt_regs *regs)
+{
+	static atomic_t records = ATOMIC_INIT(0);
+	u64 ttbr0, ttbr1, tcr, pc, pstate;
+	unsigned long untagged;
+	unsigned int cpu, fnv;
+	int seq;
+
+	if (user_mode(regs) || ESR_ELx_EC(esr) != ESR_ELx_EC_DABT_CUR)
+		return;
+	seq = atomic_fetch_add_unless(&records, 1, 4);
+	if (seq >= 4)
+		return;
+
+	ttbr0 = read_sysreg(ttbr0_el1);
+	ttbr1 = read_sysreg(ttbr1_el1);
+	tcr = read_sysreg(tcr_el1);
+	pc = regs->pc;
+	pstate = regs->pstate;
+	cpu = raw_smp_processor_id();
+	untagged = untagged_addr(far);
+	fnv = !!(esr & ESR_ELx_FnV);
+	pr_emerg("LEON_SEA seq=%d cpu=%u far=%016lx untagged=%016lx fnv=%u esr=%016lx ttbr0=%016llx ttbr1=%016llx tcr=%016llx pc=%016llx pstate=%016llx\n",
+		 seq + 1, cpu, far, untagged, fnv, esr, ttbr0, ttbr1, tcr,
+		 pc, pstate);
+}
+
