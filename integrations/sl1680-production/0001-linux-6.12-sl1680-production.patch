@@ -46,6 +47,64 @@
 #define NO_CONT_MAPPINGS	BIT(1)
 #define NO_EXEC_MAPPINGS	BIT(2)	/* assumes FEAT_HPDS is not used */
 
+/*
+ * Scoped SL1680 boot workaround: retain the ordinary allocation and place the
+ * first linear-map PMD table in the validated lower physical interval. The
+ * underlying fault is not established; this is not a general RAM-tail rule.
+ * Only the dedicated board configuration may enable this policy.
+ *
+ * Generic constructors also run after init, so their policy state must remain
+ * readable then. Only map_mem(swapper_pg_dir) activates it, and finish clears
+ * active before this state becomes read-only. Saved scalars never read tables.
+ */
+#ifdef CONFIG_ARM64_SL1680_L2_PLACEMENT
+#define SL1680_L2_ALLOC_START ((phys_addr_t)0x80000000)
+#define SL1680_L2_ALLOC_END   ((phys_addr_t)0xc0000000)
+static struct {
+	phys_addr_t retained_original, replacement, range_end;
+	unsigned long target_va, target_pgd_prefix;
+	bool active, pending, applied;
+} sl1680_l2_placement __ro_after_init;
+
+static void __init sl1680_l2_begin(pgd_t *pgdp)
+{
+	BUILD_BUG_ON(PAGE_SHIFT != 12 || VA_BITS != 39 ||
+		     CONFIG_PGTABLE_LEVELS != 3);
+	if (pgdp != swapper_pg_dir)
+		return;
+	if (!initial_boot_params ||
+	    !of_flat_dt_is_compatible(of_get_flat_dt_root(), "syna,dolphin"))
+		panic("SL1680 L2 policy requires a Dolphin flat DT\n");
+	if (sl1680_l2_placement.active || sl1680_l2_placement.pending ||
+	    sl1680_l2_placement.applied)
+		panic("SL1680 L2 policy re-entry\n");
+
+	sl1680_l2_placement.target_va = _PAGE_OFFSET(VA_BITS_MIN);
+	sl1680_l2_placement.target_pgd_prefix =
+		sl1680_l2_placement.target_va >> PGDIR_SHIFT;
+	sl1680_l2_placement.active = true;
+}
+
+static void __init sl1680_l2_finish(void)
+{
+	if (!sl1680_l2_placement.active)
+		return;
+	if (sl1680_l2_placement.pending || !sl1680_l2_placement.applied)
+		panic("SL1680 L2 policy target was not placed\n");
+	sl1680_l2_placement.active = false;
+	pr_info("SL1680_L2_POLICY target_va=%016lx target_pgd_prefix=%lx original=%016llx replacement=%016llx min=%016llx end=%016llx retained_original=1 no_table_reads=1\n",
+		sl1680_l2_placement.target_va,
+		sl1680_l2_placement.target_pgd_prefix,
+		(u64)sl1680_l2_placement.retained_original,
+		(u64)sl1680_l2_placement.replacement,
+		(u64)SL1680_L2_ALLOC_START,
+		(u64)sl1680_l2_placement.range_end);
+}
+#else
+static inline void sl1680_l2_begin(pgd_t *pgdp) { }
+static inline void sl1680_l2_finish(void) { }
+#endif
+
 u64 kimage_voffset __ro_after_init;
 EXPORT_SYMBOL(kimage_voffset);
 
@@ -110,13 +169,44 @@ EXPORT_SYMBOL(phys_mem_access_prot);
 static phys_addr_t __init early_pgtable_alloc(int shift)
 {
 	phys_addr_t phys;
+#ifdef CONFIG_ARM64_SL1680_L2_PLACEMENT
+	phys_addr_t replacement, end;
+#endif
 
 	phys = memblock_phys_alloc_range(PAGE_SIZE, PAGE_SIZE, 0,
 					 MEMBLOCK_ALLOC_NOLEAKTRACE);
 	if (!phys)
 		panic("Failed to allocate page table page\n");
 
+#ifdef CONFIG_ARM64_SL1680_L2_PLACEMENT
+	if (!sl1680_l2_placement.pending)
+		return phys;
+	if (!sl1680_l2_placement.active || shift != PMD_SHIFT ||
+	    sl1680_l2_placement.applied || !PAGE_ALIGNED(phys))
+		panic("SL1680 L2 policy invalid allocation request\n");
+
+	/* Never clear, install or release this ordinary allocated page. */
+	sl1680_l2_placement.retained_original = phys;
+	end = min_t(phys_addr_t, SL1680_L2_ALLOC_END,
+		    memblock_get_current_limit());
+	sl1680_l2_placement.range_end = end;
+	if (end < SL1680_L2_ALLOC_START + PAGE_SIZE)
+		panic("SL1680 L2 policy empty allocation range\n");
+
+	/* Strict range; ordinary memblock free/reserved/NOMAP filtering. */
+	replacement = memblock_phys_alloc_range(PAGE_SIZE, PAGE_SIZE,
+					      SL1680_L2_ALLOC_START, end);
+	if (!replacement || !PAGE_ALIGNED(replacement) ||
+	    replacement < SL1680_L2_ALLOC_START ||
+	    replacement > end - PAGE_SIZE || replacement == phys)
+		panic("SL1680 L2 policy allocation failed\n");
+
+	sl1680_l2_placement.replacement = replacement;
+	sl1680_l2_placement.applied = true;
+	return replacement;
+#else
 	return phys;
+#endif
 }
 
