+static ssize_t cgroup_pressure_write(struct kernfs_open_file *of, char *buf,
+				    size_t nbytes, enum psi_res res)
+{
+	struct cgroup_file_ctx *ctx;
+	struct psi_trigger *new;
+	struct cgroup *cgrp;
+	struct psi_group *psi;
+	bool need_poll_worker;
+	ssize_t ret = 0;
+
+	cgrp = cgroup_kn_lock_live(of->kn, false);
+	if (!cgrp)
+		return -ENODEV;
+	ctx = of->priv;
+	if (!ctx) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+	if (ctx->psi.trigger) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	psi = cgroup_psi(cgrp);
+	new = psi_trigger_create(psi, buf, nbytes, res, of,
+				 &need_poll_worker);
+	if (IS_ERR(new)) {
+		ret = PTR_ERR(new);
+		goto out_unlock;
+	}
+	if (need_poll_worker) {
+		/* Keep the cgrp pin and kernfs active reference broken. */
+		mutex_unlock(&cgroup_mutex);
+		ret = psi_trigger_create_poll_worker(psi);
+		mutex_lock(&cgroup_mutex);
+		ctx = of->priv;
+		if (!ret && !ctx)
+			ret = -ENODEV;
+		if (ret) {
+			psi_trigger_destroy(new);
+			goto out_unlock;
+		}
+	}
+	smp_store_release(&ctx->psi.trigger, new);
+out_unlock:
+	cgroup_kn_unlock(of->kn);
+	return ret ? ret : nbytes;
+}
