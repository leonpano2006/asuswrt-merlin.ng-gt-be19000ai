diff --git a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/block/bio-blkcg-abi.c b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/block/bio-blkcg-abi.c
new file mode 100644
--- /dev/null
+++ b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/block/bio-blkcg-abi.c
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included by bio.c. Only the kernel owns this map; bio's existing padding
+ * stores a handle, keeping embedded/stack bios used by vendor modules valid.
+ * A bio's normal ownership serializes association/uninit; the IDR lock protects
+ * concurrent independent bios. CSS references live until bio_uninit/reset.
+ */
+#include <linux/idr.h>
+static DEFINE_IDR(bio_css_ids);
+static DEFINE_SPINLOCK(bio_css_lock);
+#define BIO_CSS_NOMEM (~0U)
+
+struct cgroup_subsys_state *bio_blkcg_css(struct bio *bio)
+{
+	struct cgroup_subsys_state *css = NULL;
+	unsigned long flags;
+	unsigned int id = bio->bi_abi_css_id;
+	if (id && id != BIO_CSS_NOMEM) {
+		spin_lock_irqsave(&bio_css_lock, flags);
+		css = idr_find(&bio_css_ids, id);
+		spin_unlock_irqrestore(&bio_css_lock, flags);
+	}
+	return css;
+}
+EXPORT_SYMBOL_GPL(bio_blkcg_css);
+
+int bio_associate_blkcg(struct bio *bio, struct cgroup_subsys_state *css)
+{
+	unsigned long flags;
+	int id;
+	if (bio->bi_abi_css_id == BIO_CSS_NOMEM)
+		return -ENOMEM;
+	if (bio->bi_abi_css_id)
+		return -EBUSY;
+	css_get(css);
+	spin_lock_irqsave(&bio_css_lock, flags);
+	id = idr_alloc(&bio_css_ids, css, 1, 0, GFP_ATOMIC);
+	spin_unlock_irqrestore(&bio_css_lock, flags);
+	if (id < 0) {
+		css_put(css);
+		bio->bi_abi_css_id = BIO_CSS_NOMEM;
+		return -ENOMEM;
+	}
+	bio->bi_abi_css_id = id;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(bio_associate_blkcg);
+#ifdef CONFIG_MEMCG
+int bio_associate_blkcg_from_page(struct bio *bio, struct page *page)
+{
+	struct cgroup_subsys_state *css;
+	int ret;
+	if (!page->mem_cgroup)
+		return 0;
+	css = cgroup_get_e_css(page->mem_cgroup->css.cgroup, &io_cgrp_subsys);
+	ret = bio_associate_blkcg(bio, css);
+	css_put(css);
+	return ret;
+}
+#endif
+int bio_associate_blkg(struct bio *bio, struct blkcg_gq *blkg)
+{
+	/* Low-latency policies are excluded by Kconfig for this ABI. */
+	return -EOPNOTSUPP;
+}
+void bio_disassociate_task(struct bio *bio)
+{
+	struct cgroup_subsys_state *css = NULL;
+	unsigned long flags;
+	unsigned int id = bio->bi_abi_css_id;
+	if (id && id != BIO_CSS_NOMEM) {
+		spin_lock_irqsave(&bio_css_lock, flags);
+		css = idr_remove(&bio_css_ids, id);
+		spin_unlock_irqrestore(&bio_css_lock, flags);
+	}
+	bio->bi_abi_css_id = 0;
+	if (css)
+		css_put(css);
+}
+void bio_clone_blkcg_association(struct bio *dst, struct bio *src)
+{
+	struct cgroup_subsys_state *css = bio_blkcg_css(src);
+	if (src->bi_abi_css_id == BIO_CSS_NOMEM)
+		dst->bi_abi_css_id = BIO_CSS_NOMEM;
+	else if (css)
+		/* On ENOMEM the destination stays poisoned until submission. */
+		bio_associate_blkcg(dst, css);
+}
+EXPORT_SYMBOL_GPL(bio_clone_blkcg_association);
