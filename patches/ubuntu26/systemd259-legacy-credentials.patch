+static int setup_credentials_legacy_mount(
+                const ExecContext *context,
+                const CGroupContext *cgroup_context,
+                const ExecParameters *params,
+                const char *unit,
+                const char *cred_dir,
+                bool dir_mounted,
+                uid_t uid,
+                gid_t gid) {
+
+        _cleanup_free_ char *parent = NULL, *workspace_path = NULL;
+        _cleanup_(umount_and_rmdir_and_freep) char *workspace = NULL;
+        _cleanup_close_ int dfd = -EBADF;
+        struct statvfs sv;
+        int r;
+
+        parent = path_join(params->prefix[EXEC_DIRECTORY_RUNTIME], "systemd/temporary-credentials");
+        if (!parent)
+                return -ENOMEM;
+        r = mkdir_safe_label(parent, 0700, getuid(), getgid(), MKDIR_WARN_MODE);
+        if (r < 0)
+                return r;
+        r = tempfn_random_child(parent, "cred", &workspace_path);
+        if (r < 0)
+                return r;
+        r = mkdir_label(workspace_path, 0700);
+        if (r < 0)
+                return r;
+        workspace = TAKE_PTR(workspace_path); /* Arm cleanup only for the directory we created. */
+        r = mount_credentials_fs_legacy(workspace);
+        if (r < 0)
+                return r; /* Never use a plain or swappable directory on this path. */
+
+        dfd = open(workspace, O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW);
+        if (dfd < 0)
+                return -errno;
+        (void) label_fix_full(dfd, /* inode_path= */ NULL, cred_dir, /* flags= */ 0);
+        r = acquire_credentials(context, cgroup_context, params, unit, dfd, uid, gid, /* ownership_ok= */ true);
+        if (r < 0)
+                return r;
+        r = credentials_dir_finalize_permissions(dfd, uid, gid, /* ownership_ok= */ true);
+        if (r < 0)
+                return r;
+
+        /* Lock the superblock before publishing. A bind mount inherits the source mount flags;
+         * unlike MS_MOVE this also works when the workspace's parent is shared. */
+        r = mount_nofollow_verbose(LOG_DEBUG, NULL, workspace, NULL,
+                                  MS_REMOUNT|credentials_fs_mount_flags(/* ro= */ true), NULL);
+        if (r < 0)
+                return r;
+        if (fstatvfs(dfd, &sv) < 0)
+                return -errno;
+        if (!FLAGS_SET(sv.f_flag, ST_RDONLY|ST_NOSUID|ST_NODEV|ST_NOEXEC))
+                return -EPERM;
+
+        /* Match the pre-6.5 replacement semantics of the modern path below: stage and lock
+         * everything first, then detach an old mount before publishing the new one. A fresh
+         * replacement has a brief gap; no half-written or writable store is ever exposed. */
+        if (dir_mounted) {
+                r = umount_verbose(LOG_DEBUG, cred_dir, MNT_DETACH|UMOUNT_NOFOLLOW);
+                if (r < 0)
+                        return r;
+        }
+        r = mount_nofollow_verbose(LOG_DEBUG, workspace, cred_dir, NULL, MS_BIND, NULL);
+        if (r < 0)
+                return r;
+        _cleanup_close_ int final_fd = open(cred_dir, O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW);
+        if (final_fd < 0)
+                r = -errno;
+        else if (fstatvfs(final_fd, &sv) < 0)
+                r = -errno;
+        else if (!FLAGS_SET(sv.f_flag, ST_RDONLY|ST_NOSUID|ST_NODEV|ST_NOEXEC))
+                r = -EPERM;
+        else
+                r = 0;
+        if (r < 0) {
+                (void) umount2(cred_dir, MNT_DETACH|UMOUNT_NOFOLLOW);
+                return r;
+        }
+        log_debug("Published read-only legacy ramfs credentials for unit '%s'.", unit);
+        return 0;
+}
