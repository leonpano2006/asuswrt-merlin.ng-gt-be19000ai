+int mount_credentials_fs_legacy(const char *path) {
+        assert(path);
+
+        /* Linux before 5.2 has no fsopen(). Use ramfs, never a swappable tmpfs or a plain
+         * directory. This is deliberately stricter than the generic modern helper. */
+        return mount_nofollow_verbose(LOG_DEBUG, "systemd-credentials", path, "ramfs",
+                                      credentials_fs_mount_flags(/* ro= */ false), "mode=0700");
+}
+
