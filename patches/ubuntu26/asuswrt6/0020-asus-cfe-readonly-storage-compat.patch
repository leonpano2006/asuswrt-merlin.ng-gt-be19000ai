 int start_envrams(void) {
+#if defined(LEON_SYSTEMD_RC) && LEON_SYSTEMD_RC == 1
+	leon_cfe_defaults_require();
+	if (!pids("envrams")) {
+		/* Keep the native RO /mnt/defaults mounted throughout the daemon's
+		 * lifetime. No /dev/defaults mount or compatibility-path unmount. */
+		if (system("/usr/sbin/envrams >/dev/null"))
+			leon_cfe_readonly_refuse("envrams-start");
+		sleep(1);
+		if (!pids("envrams"))
+			leon_cfe_readonly_refuse("envrams-not-ready");
+		return 1;
+	}
+	return 0;
+#else
 	int ret;
 
 	ret = 0;
@@ -5904,15 +5921,18 @@
 	}
 #endif
 	return ret;
+#endif
 }
 
 void stop_envrams(void) {
 	killall_tk("envrams");
+#if !defined(LEON_SYSTEMD_RC) || LEON_SYSTEMD_RC != 1
 #if defined(RTCONFIG_HND_ROUTER_AX_6756) || defined(RTCONFIG_HND_ROUTER_BE_4916)
 #ifdef RTCONFIG_USB
 	system("umount /tmp/mnt/defaults &> /dev/null");
 #else
 	system("umount /mnt/defaults &> /dev/null");
+#endif
 #endif
 #endif
 }
