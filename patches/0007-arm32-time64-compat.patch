diff --git a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/kernel/signal.c b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/kernel/signal.c
--- a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/kernel/signal.c
+++ b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/kernel/signal.c
@@ -3266,6 +3266,36 @@
 
 	return ret;
 }
+
+/* New timeout layout does not change ARM32 sigset/siginfo layout. */
+COMPAT_SYSCALL_DEFINE4(rt_sigtimedwait_time64,
+		const compat_sigset_t __user *, uthese,
+		struct compat_siginfo __user *, uinfo,
+		const struct __kernel_timespec __user *, uts,
+		compat_size_t, sigsetsize)
+{
+	sigset_t s;
+	struct timespec64 ts64;
+	struct timespec ts;
+	siginfo_t info;
+	int ret;
+
+	if (sigsetsize != sizeof(compat_sigset_t))
+		return -EINVAL;
+	if (get_compat_sigset(&s, uthese))
+		return -EFAULT;
+	if (uts) {
+		if (get_timespec64(&ts64, uts))
+			return -EFAULT;
+		ts = timespec64_to_timespec(ts64);
+	}
+
+	ret = do_sigtimedwait(&s, &info, uts ? &ts : NULL);
+	if (ret > 0 && uinfo && copy_siginfo_to_user32(uinfo, &info))
+		return -EFAULT;
+	return ret;
+}
+
 #endif
 
