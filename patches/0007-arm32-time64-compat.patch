diff --git a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/compat.c b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/compat.c
--- a/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/compat.c
+++ b/release/src-rt-5.04behnd.4916/kernel/linux-4.19/net/compat.c
@@ -843,6 +843,32 @@
