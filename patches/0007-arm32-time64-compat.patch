 }
 
+/* 64-bit timeout, but ARM32 message/iovec/control-message layouts. */
+COMPAT_SYSCALL_DEFINE5(recvmmsg_time64, int, fd,
+		       struct compat_mmsghdr __user *, mmsg,
+		       unsigned int, vlen, unsigned int, flags,
+		       struct __kernel_timespec __user *, timeout)
+{
+	struct timespec64 ts64;
+	struct timespec ts;
+	int ret;
+
+	if (timeout) {
+		if (get_timespec64(&ts64, timeout))
+			return -EFAULT;
+		ts = timespec64_to_timespec(ts64);
+	}
+
+	ret = __sys_recvmmsg(fd, (struct mmsghdr __user *)mmsg, vlen,
+			    flags | MSG_CMSG_COMPAT, timeout ? &ts : NULL);
+	if (ret > 0 && timeout) {
+		ts64 = timespec_to_timespec64(ts);
+		if (put_timespec64(&ts64, timeout))
+			return -EFAULT;
+	}
+	return ret;
+}
+
 COMPAT_SYSCALL_DEFINE2(socketcall, int, call, u32 __user *, args)
 {
 	u32 a[AUDITSC_ARGS];
