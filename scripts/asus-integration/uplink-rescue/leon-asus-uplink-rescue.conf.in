# SOURCE-ONLY DRAFT. systemd owns fixed169.254.190.15:2223 listener.
Port 2223
AddressFamily inet
HostKey /etc/ssh/ssh_host_ed25519_key
HostKeyAlgorithms ssh-ed25519
AllowUsers MastermixStudios@169.254.190.51
PermitRootLogin no
AuthenticationMethods publickey
PubkeyAuthentication yes
PubkeyAcceptedAlgorithms ssh-ed25519
AuthorizedKeysFile /var/lib/leon-asus-ssh/recovery_authorized_keys
StrictModes yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
HostbasedAuthentication no
UsePAM yes
DisableForwarding yes
PermitTunnel no
GatewayPorts no
X11Forwarding no
PermitUserEnvironment no
PermitUserRC no
UseDNS no
LoginGraceTime 30
MaxAuthTries 2
Subsystem sftp internal-sftp
