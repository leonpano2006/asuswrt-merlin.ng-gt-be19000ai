[Unit]
Description=One bounded native network and SSH trial snapshot

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/libexec/leon-asus/trial-runtime-snapshot
TimeoutStartSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Read the native sshd master's protected proc identity without executing or
# modifying it. Network changes and filesystem overrides need no capability.
CapabilityBoundingSet=CAP_SYS_PTRACE
StandardOutput=journal
StandardError=journal
SyslogIdentifier=leon-asus-trial-snapshot
